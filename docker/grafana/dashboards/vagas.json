          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH b AS (\n  SELECT generate_series(\n    date_trunc('${periodo}', $__timeFrom()::timestamptz AT TIME ZONE 'America/Fortaleza'),\n    $__timeTo()::timestamptz AT TIME ZONE 'America/Fortaleza',\n    interval '1 ${periodo}'\n  ) AS t\n),\nty AS (\n  SELECT DISTINCT type FROM job WHERE type::text IN ($type) AND kind::text IN ($kind)\n),\ne AS (\n  SELECT date_trunc('${periodo}', (created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza')) AS t, type, count(*) AS n\n  FROM job WHERE type::text IN ($type) AND kind::text IN ($kind) GROUP BY 1, 2\n)\nSELECT b.t AT TIME ZONE 'America/Fortaleza' AS time,\n       ty.type::text AS metric,\n       coalesce(e.n, 0) AS n\nFROM b\nCROSS JOIN ty\nLEFT JOIN e ON e.t = b.t AND e.type = ty.type\nORDER BY 1"
        }
