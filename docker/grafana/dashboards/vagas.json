    {
      "type": "timeseries",
      "id": 17,
      "title": "Entraram x finalizadas por ${periodo:text}",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Granularidade no filtro Período (dia/semana/mês). Clique num ponto para listar as vagas daquele período na tabela abaixo.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH j AS (\n  SELECT created_at, finished_at FROM job WHERE type::text IN ($type) AND kind::text IN ($kind)\n),\nb AS (\n  SELECT generate_series(\n    date_trunc('${periodo}', $__timeFrom()::timestamptz AT TIME ZONE 'America/Fortaleza'),\n    $__timeTo()::timestamptz AT TIME ZONE 'America/Fortaleza',\n    interval '1 ${periodo}'\n  ) AS t\n),\ne AS (\n  SELECT date_trunc('${periodo}', (created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza')) AS t, count(*) AS n FROM j GROUP BY 1\n),\nf AS (\n  SELECT date_trunc('${periodo}', (finished_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza')) AS t, count(*) AS n FROM j WHERE finished_at IS NOT NULL GROUP BY 1\n)\nSELECT b.t AT TIME ZONE 'America/Fortaleza' AS time,\n       coalesce(e.n, 0) AS \"Entraram\",\n       coalesce(f.n, 0) AS \"Finalizadas\"\nFROM b\nLEFT JOIN e ON e.t = b.t\nLEFT JOIN f ON f.t = b.t\nORDER BY 1"
        }
      ],
