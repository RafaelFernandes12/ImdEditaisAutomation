        "definition": "SELECT CASE\n  WHEN s.t IS NULL THEN 'período do dashboard'\n  WHEN '${periodo}' = 'day' THEN 'dia ' || to_char(s.t, 'DD/MM/YYYY')\n  WHEN '${periodo}' = 'week' THEN 'semana de ' || to_char(s.t, 'DD/MM') || ' a ' || to_char(s.t + interval '6 days', 'DD/MM/YYYY')\n  ELSE 'mês ' || to_char(s.t, 'MM/YYYY')\nEND\nFROM (SELECT to_timestamp(nullif('${bucket}', '')::bigint / 1000.0) AT TIME ZONE 'America/Fortaleza' AS t) s",
        "query": "SELECT CASE\n  WHEN s.t IS NULL THEN 'período do dashboard'\n  WHEN '${periodo}' = 'day' THEN 'dia ' || to_char(s.t, 'DD/MM/YYYY')\n  WHEN '${periodo}' = 'week' THEN 'semana de ' || to_char(s.t, 'DD/MM') || ' a ' || to_char(s.t + interval '6 days', 'DD/MM/YYYY')\n  ELSE 'mês ' || to_char(s.t, 'MM/YYYY')\nEND\nFROM (SELECT to_timestamp(nullif('${bucket}', '')::bigint / 1000.0) AT TIME ZONE 'America/Fortaleza' AS t) s",
