      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sel AS (SELECT to_timestamp(nullif('${bucket}', '')::bigint / 1000.0) AT TIME ZONE 'America/Fortaleza' AS t)\nSELECT * FROM (\n  SELECT 'Entrou' AS \"Evento\", created_at AS \"Quando\", type::text AS \"Tipo\",\n         kind::text AS \"Categoria\",\n         CASE WHEN is_active THEN 'Aberta' ELSE 'Finalizada' END AS \"Status atual\",\n         title AS \"Título\",\n         link AS \"Link\"\n  FROM job, sel\n  WHERE type::text IN ($type) AND kind::text IN ($kind) AND CASE WHEN sel.t IS NULL THEN $__timeFilter(created_at) ELSE date_trunc('${periodo}', (created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza')) = sel.t END\n  UNION ALL\n  SELECT 'Finalizou' AS \"Evento\", finished_at AS \"Quando\", type::text AS \"Tipo\",\n         kind::text AS \"Categoria\",\n         CASE WHEN is_active THEN 'Aberta' ELSE 'Finalizada' END AS \"Status atual\",\n         title AS \"Título\",\n         link AS \"Link\"\n  FROM job, sel\n  WHERE type::text IN ($type) AND kind::text IN ($kind) AND finished_at IS NOT NULL AND CASE WHEN sel.t IS NULL THEN $__timeFilter(finished_at) ELSE date_trunc('${periodo}', (finished_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza')) = sel.t END\n) ev\nORDER BY \"Quando\" DESC\nLIMIT 500"
        }
      ],
