    {
      "type": "table",
      "id": 15,
      "title": "Resumo por tipo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 10,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT type::text AS \"Tipo\",\n       kind::text AS \"Categoria\",\n       count(*) AS \"Total\",\n       count(*) FILTER (WHERE is_active) AS \"Abertas\",\n       count(*) FILTER (WHERE NOT is_active) AS \"Finalizadas\",\n       count(*) FILTER (WHERE (created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza') >= (now() AT TIME ZONE 'America/Fortaleza') - interval '7 days') AS \"Entraram 7d\",\n       count(*) FILTER (WHERE (created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza') >= (now() AT TIME ZONE 'America/Fortaleza') - interval '30 days') AS \"Entraram 30d\",\n       count(*) FILTER (WHERE (finished_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza') >= (now() AT TIME ZONE 'America/Fortaleza') - interval '30 days') AS \"Finalizadas 30d\",\n       max(created_at) AS \"Última entrada\"\nFROM job\nWHERE type::text IN ($type) AND kind::text IN ($kind)\nGROUP BY type, kind\nORDER BY \"Total\" DESC"
        }
      ],
      "fieldConfig": {
