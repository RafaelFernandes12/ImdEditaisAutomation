// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusJob {
  SENDED
  HOMOLOGACAO
  ENTREVISTA
  RESERVA
  SUCESS
  FAILED
}

enum JobType {
  IMD
  JERIMUM
  STI
}

enum PdfTipo {
  EDITAL
  HOMOLOGACAO
  ENTREVISTA
  CURRICULO
  RESULTADO
}

model Job {
  id         Int       @id @default(autoincrement())
  title      String    @unique
  link       String    @unique
  type       JobType
  isActive   Boolean
  finishedAt DateTime?
  summary    String
  keyWords   String
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt() @db.Timestamp(6)

  edital  Edital?
  jerimum Jerimum?

  sends             Sends[]
  UserSubscriptions UserSubscriptions[]
}

model Edital {
  jobId Int @id
  job   Job @relation(fields: [jobId], references: [id])

  subscriptionUntil DateTime
  validUntil        DateTime?

  pdfs Pdf[]
}

model Jerimum {
  jobId Int @id
  job   Job @relation(fields: [jobId], references: [id])

  description  String
  contractType String
}

model Pdf {
  id    Int     @id @default(autoincrement())
  label String
  text  String
  link  String  @unique
  type  PdfTipo

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  editalId Int
  edital   Edital  @relation(fields: [editalId], references: [jobId])
  sends    Sends[]
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  chatId   String  @unique
  contact  String  @unique
  isActive Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  sends             Sends[]
  reminders         Reminders[]
  UserSubscriptions UserSubscriptions[]
}

model UserSubscriptions {
  id Int @id @default(autoincrement())

  userId Int
  jobId  Int

  status StatusJob

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)
}

model Sends {
  pdf  Pdf  @relation(fields: [pdfId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)
  pdfId      Int
  jobId      Int
  userId     Int

  @@id([pdfId, jobId, userId])
}

model Reminders {
  id       Int      @id @default(autoincrement())
  reminder DateTime
  text     String
  user     User     @relation(fields: [userId], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  userId Int
}
