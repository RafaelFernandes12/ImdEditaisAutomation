// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusJob {
  SENDED
  HOMOLOGACAO
  ENTREVISTA
  RESERVA
  SUCESS
  FAILED

  @@map("status_job")
}

enum Modelo {
  CLT
  PJ
  ESTAGIO
  FREELANCE
  BOLSISTA
}

enum Formato {
  PRESENCIAL
  HIBRIDO
  REMOTO
  NAO_INFORMADO
}

enum Senioridade {
  ESTAGIO
  TRAINEE
  JUNIOR
  PLENO
  SENIOR
  TECHLEAD
  GRADUACAO
  GRADUADO
  MESTRADO
  DOUTORADO
}

enum JobKind {
  EDITAL
  VAGA

  @@map("job_kind")
}

enum JobType {
  IMD
  JERIMUM
  STI
  BACKEND_GITHUB
  FRONTEND_GITHUB

  @@map("job_type")
}

enum PdfTipo {
  EDITAL
  HOMOLOGACAO
  ENTREVISTA
  CURRICULO
  RESULTADO

  @@map("pdf_tipo")
}

model Job {
  id          Int       @id @default(autoincrement())
  title       String    @unique
  link        String    @unique
  type        JobType
  kind        JobKind
  isActive    Boolean   @map("is_active")
  finishedAt  DateTime? @map("finished_at")
  summary     String
  keyWords    String    @map("key_words")
  ecossytem   String    @default("")
  // No edital é uma cópia do texto do primeiro pdf (o edital em si).
  description String

  // Só edital
  subscriptionUntil DateTime? @map("subscription_until")
  validUntil        DateTime? @map("valid_until")

  formato     Formato
  city        String
  state       String
  modelo      Modelo[]
  senioridade Senioridade[]

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  pdfs              Pdf[]
  sends             Sends[]
  UserSubscriptions UserSubscriptions[]

  @@map("job")
}

model Pdf {
  id    Int     @id @default(autoincrement())
  label String
  text  String
  link  String  @unique
  type  PdfTipo

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  jobId Int     @map("job_id")
  job   Job     @relation(fields: [jobId], references: [id])
  sends Sends[]

  @@map("pdf")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  chatId   String  @unique @map("chat_id")
  contact  String  @unique
  isActive Boolean @default(true) @map("is_active")

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  sends             Sends[]
  reminders         Reminders[]
  UserSubscriptions UserSubscriptions[]
  UserPreferences   UserPreferences?

  @@map("user")
}

model UserPreferences {
  id          Int           @id @default(autoincrement())
  keyWords    String        @default("") @map("key_words")
  modelo      Modelo[]
  formato     Formato
  city        String
  state       String
  senioridade Senioridade[]
  user        User          @relation(fields: [userId], references: [id])
  userId      Int           @unique @map("user_id")

  @@map("user_preferences")
}

model UserSubscriptions {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")
  jobId  Int @map("job_id")

  status StatusJob

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  @@map("user_subscriptions")
}

model Sends {
  id Int @id @default(autoincrement())

  pdf  Pdf? @relation(fields: [pdfId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)
  pdfId      Int?     @map("pdf_id")
  jobId      Int      @map("job_id")
  userId     Int      @map("user_id")

  @@unique([userId, jobId, pdfId])
  @@map("sends")
}

model Reminders {
  id       Int      @id @default(autoincrement())
  reminder DateTime
  text     String
  user     User     @relation(fields: [userId], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  userId Int @map("user_id")

  @@map("reminders")
}
