// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusJob {
  SENDED
  HOMOLOGACAO
  ENTREVISTA
  RESERVA
  SUCESS
  FAILED

  @@map("status_job")
}

enum Modelo {
  CLT
  PJ
  ESTAGIO
  FREELANCE
  BOLSISTA
}

enum Formato {
  PRESENCIAL
  HIBRIDO
  REMOTO
}

enum Senioridade {
  ESTAGIO
  TRAINEE
  JUNIOR
  PLENO
  SENIOR
  TECHLEAD
}

enum Escolaridade {
  GRADUACAO
  GRADUADO
  MESTRADO
  DOUTORADO
}

enum JobKind {
  EDITAL
  VAGA

  @@map("job_kind")
}

enum JobType {
  IMD
  JERIMUM
  STI
  BACKEND_GITHUB
  FRONTEND_GITHUB

  @@map("job_type")
}

enum PdfTipo {
  EDITAL
  HOMOLOGACAO
  ENTREVISTA
  CURRICULO
  RESULTADO

  @@map("pdf_tipo")
}

model Job {
  id          Int       @id @default(autoincrement())
  title       String
  link        String    @unique
  type        JobType
  kind        JobKind
  isActive    Boolean   @map("is_active")
  finishedAt  DateTime? @map("finished_at")
  // GitHub: criação da issue; demais fontes: dia da coleta.
  publishedAt DateTime? @map("published_at")
  // No edital é uma cópia do texto do primeiro pdf (o edital em si).
  description String

  // Só edital
  subscriptionUntil DateTime? @map("subscription_until")
  validUntil        DateTime? @map("valid_until")

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  sends Sends[]
  pdfs  Pdf[]
  vagas Vaga[]

  @@map("job")
}

model Vaga {
  id        Int    @id @default(autoincrement())
  summary   String
  keyWords  String @map("key_words")
  ecossytem String @default("")

  escolaridade Escolaridade?
  salary       Float?
  formato      Formato?
  city         String?
  state        String?
  modelo       Modelo?
  senioridade  Senioridade?

  jobId Int @map("job_id")
  job   Job @relation(fields: [jobId], references: [id])

  @@map("vaga")
}

model Pdf {
  id    Int     @id @default(autoincrement())
  label String
  text  String
  link  String  @unique
  type  PdfTipo

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  jobId Int     @map("job_id")
  job   Job     @relation(fields: [jobId], references: [id])
  sends Sends[]

  @@map("pdf")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  chatId   String  @unique @map("chat_id")
  contact  String  @unique
  isActive Boolean @default(true) @map("is_active")

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt() @db.Timestamp(6)

  sends           Sends[]
  reminders       Reminders[]
  UserPreferences UserPreferences?

  @@map("user")
}

model UserPreferences {
  id           Int            @id @default(autoincrement())
  keyWords     String         @default("") @map("key_words")
  modelo       Modelo[]
  formato      Formato[]
  city         String
  state        String
  salary       Float          @default(0)
  senioridade  Senioridade[]
  escolaridade Escolaridade[]
  user         User           @relation(fields: [userId], references: [id])
  userId       Int            @unique @map("user_id")

  @@map("user_preferences")
}

