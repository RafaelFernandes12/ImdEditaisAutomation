# App
NODE_ENV=development
PORT=7638
PUBLIC_URL=http://localhost:7638

# Postgres — used by docker-compose to provision the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=projeto_ai
# Running outside Docker, point at localhost; inside Docker the compose file
# overrides this with the `postgres` service host.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projeto_ai"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3 — bucket `editaisimd` is created by the minio-init service
MINIO_URL=http://localhost:9000
MINIO_REGION=us-west-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Logging
LOKI_URL=http://localhost:3100

# LLM
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Portas publicadas pelo docker-compose no host — altere se já houver algum
# desses serviços rodando na sua máquina.
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
LOKI_PORT=3100
GRAFANA_PORT=3000
